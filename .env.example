OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek（OpenAI 兼容；未配置 OPENAI_API_KEY 时作为默认 LLM 提供方）
DEEPSEEK_API_KEY=
DEEPSEEK_API=https://api.deepseek.com
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
AI_HIGH_PRECISION_MODEL=gpt-4o
AI_BULK_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gpt-4o-mini
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=local
REDIS_URL=
# 任务队列：db | redis | rq | celery（后三者需 REDIS_URL；rq/celery 需 pip install -e ".[worker]"）
JOB_QUEUE_BACKEND=db
RQ_JOB_TIMEOUT_SEC=3600
CELERY_QUEUE_NAME=ai_tp_execution
JOB_WORKER_ENABLED=true
# 生产建议 API 关闭内嵌 Worker，单独跑 python -m backend.worker（或 rq/celery worker）
JOB_WORKER_IN_API=true
# 新库：alembic upgrade head 后设 SCHEMA_BOOTSTRAP_MODE=alembic；旧库兼容 bootstrap/legacy
SCHEMA_BOOTSTRAP_MODE=bootstrap
RUN_FAILURE_ALERT_ENABLED=true
# 告警通道：generic,dingtalk,wecom（逗号分隔）
RUN_FAILURE_ALERT_CHANNELS=generic
RUN_FAILURE_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
WECOM_WEBHOOK_URL=
METRICS_ENABLED=true
# 生产建议开启；Prometheus 使用 METRICS_BEARER_TOKEN 或 X-Metrics-Token
METRICS_AUTH_ENABLED=false
METRICS_BEARER_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-tp-api
DEFAULT_ORGANIZATION_SLUG=default
AI_CREDENTIALS_ENCRYPTION_KEY=
AUDIT_LOG_RETENTION_DAYS=90
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8001/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ORGANIZATION_SLUG=default
OIDC_ORGANIZATION_CLAIM=org_slug
OIDC_DEFAULT_MEMBER_ROLES=member
OIDC_AUTO_CREATE_ORGANIZATION=false
# 多 API 副本 OIDC 回调校验 state 须配 REDIS_URL
OIDC_STATE_TTL_SEC=600
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PER_1K_TOKENS_CENTS=20
BILLING_CURRENCY=usd
BILLING_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5174/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://127.0.0.1:5174/billing/cancel
AI_CONTEXT_TTL_SEC=86400
K6_WORKER_TOKEN=
K6_LOCAL_WORKER_ENDPOINT=http://127.0.0.1:8001
K6_DISTRIBUTED_ENABLED=true
SECURITY_SCAN_MAX_PAYLOADS=8
SECURITY_SCAN_DELAY_MS=50
# 飞书知识库/云文档链接抓取（可选；需开放平台应用 + 文档授权）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_BASE_URL=https://open.feishu.cn

DATABASE_URL=sqlite:///./data/ai_tp.db

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=noreply@example.com
# 未配置 SMTP_HOST 时写入本地发件箱（开发/演示可用）；也可在「平台配置」页填写 SMTP
SMTP_DRY_RUN=true
SMTP_OUTBOX_DIR=./data/mail_outbox

# Comma-separated list for backend CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# CI Webhook 对外 URL 前缀（GitHub/GitLab 回调地址展示）
CI_WEBHOOK_PUBLIC_BASE_URL=http://127.0.0.1:8001
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
