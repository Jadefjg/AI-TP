# syntax=docker/dockerfile:1
# Thin alias: prefer building target `worker-tools` from deploy/Dockerfile.
# Kept so docs / env that reference Dockerfile.worker-tools keep working.

ARG AI_TP_API_IMAGE=ai-tp-api:local
FROM ${AI_TP_API_IMAGE}

# If the base image is already the tools stage, this is a no-op tag.
# Prefer: docker compose build with dockerfile=deploy/Dockerfile target=worker-tools

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

CMD ["/entrypoint-worker.sh"]
