# 阿里云 ECS Docker — 复制为 deploy/.env.docker
#   cp deploy/.env.docker.aliyun.example deploy/.env.docker
# 启动（默认复用 shared-mysql/shared-redis，不会再起一套库）：
#   ./deploy/scripts/aliyun-deploy.sh --build

# shared-middleware：复用 /opt/shared-infra（aliyun-deploy.sh 默认）
# isolated-middleware：栈内自带 MySQL/Redis（仅无 shared-infra 时用 --isolated）
COMPOSE_PROFILES=shared-middleware
MYSQL_HOST=shared-mysql
REDIS_URL=redis://shared-redis:6379/0

AI_TP_API_IMAGE=ai-tp-api:local
AI_TP_WORKER_IMAGE=ai-tp-api:local
AI_TP_WEB_IMAGE=ai-tp-web:local

# 生产常用 80；调试期可用 8088（安全组需放通对应端口）
WEB_PUBLISH_PORT=80

# MySQL/Redis 仅绑定 127.0.0.1（isolated 模式）；shared 模式不会启动这两类容器
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6380

MYSQL_ROOT_PASSWORD=change-me-root-strong
MYSQL_DATABASE=ai_tp
MYSQL_USER=ai_tp
MYSQL_PASSWORD=change-me-db-strong
DATABASE_URL=mysql+pymysql://ai_tp:change-me-db-strong@shared-mysql:3306/ai_tp?charset=utf8mb4

JOB_QUEUE_BACKEND=rq

DEBIAN_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# 替换为 ECS 公网 IP 或域名（含 http/https）
BACKEND_CORS_ORIGINS=http://YOUR_ECS_IP,https://tp.example.com
SCHEMA_BOOTSTRAP_MODE=alembic
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-string-min-32-chars

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-on-first-login
BOOTSTRAP_ADMIN_SYNC_PASSWORD=false
AUTH_REGISTRATION_ENABLED=true

DEEPSEEK_API_KEY=
DEEPSEEK_API=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

SMTP_DRY_RUN=true
SMTP_FROM=noreply@example.com

METRICS_ENABLED=true
METRICS_AUTH_ENABLED=true
METRICS_BEARER_TOKEN=replace-with-random-token

# shared-middleware 内存（isolated 时 aliyun-deploy.sh 会覆盖为更大值）
API_MEM_LIMIT=320m
WORKER_MEM_LIMIT=256m
WEB_MEM_LIMIT=48m
MYSQL_IMAGE=mysql:8.0
MYSQL_INNODB_BUFFER_POOL_SIZE=96M
MYSQL_INNODB_LOG_BUFFER_SIZE=8M
MYSQL_PERFORMANCE_SCHEMA=OFF
MYSQL_MAX_CONNECTIONS=50
MYSQL_MEM_LIMIT=256m
REDIS_MEM_LIMIT=64m

CI_WEBHOOK_PUBLIC_BASE_URL=http://YOUR_ECS_IP/api
BILLING_CHECKOUT_SUCCESS_URL=http://YOUR_ECS_IP/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://YOUR_ECS_IP/billing/cancel
