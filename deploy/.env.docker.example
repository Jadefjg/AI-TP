# Copy to deploy/.env.docker and fill secrets before: docker compose --env-file deploy/.env.docker up -d --build
# NEVER commit deploy/.env.docker

# --- Registry images (Docker Hub / GHCR) ---
# Local default tags work with --build. For Hub push/pull, set e.g.:
#   AI_TP_API_IMAGE=youruser/ai-tp-api:latest
#   AI_TP_WEB_IMAGE=youruser/ai-tp-web:latest
# Then: ./deploy/scripts/push-images.sh youruser
# On another machine: docker compose --env-file deploy/.env.docker pull && up -d
AI_TP_API_IMAGE=ai-tp-api:local
AI_TP_WEB_IMAGE=ai-tp-web:local

# --- Compose publish ports ---
WEB_PUBLISH_PORT=8080
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6379

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ai_tp
MYSQL_USER=ai_tp
MYSQL_PASSWORD=change-me-db

# --- Queue ---
JOB_QUEUE_BACKEND=rq

# --- App (read by API/Worker containers) ---
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SCHEMA_BOOTSTRAP_MODE=alembic
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-string

# Bootstrap admin — must match login page default for first-time local Docker.
# Only applied when the admin user is created; change password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456

# LLM (至少配置其一，否则走 stub)
DEEPSEEK_API_KEY=
DEEPSEEK_API=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Mail
SMTP_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Metrics
METRICS_ENABLED=true
METRICS_AUTH_ENABLED=false
METRICS_BEARER_TOKEN=

# Optional Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_BASE_URL=https://open.feishu.cn

# Public URLs (adjust to your domain when exposing)
CI_WEBHOOK_PUBLIC_BASE_URL=http://localhost:8080/api
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:8080/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:8080/billing/cancel
