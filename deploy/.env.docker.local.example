# 本地 Docker — 复制为 deploy/.env.docker
#   cp deploy/.env.docker.local.example deploy/.env.docker
# 启动：
#   docker compose -f docker-compose.local.yml up -d --build

AI_TP_API_IMAGE=ai-tp-api:local
AI_TP_WORKER_IMAGE=ai-tp-api:local
AI_TP_WEB_IMAGE=ai-tp-web:local

WEB_PUBLISH_PORT=8088
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6380

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ai_tp
MYSQL_USER=ai_tp
MYSQL_PASSWORD=change-me-db
DATABASE_URL=mysql+pymysql://ai_tp:change-me-db@mysql:3306/ai_tp?charset=utf8mb4

JOB_QUEUE_BACKEND=rq

BACKEND_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
SCHEMA_BOOTSTRAP_MODE=alembic
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-string

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_SYNC_PASSWORD=true
AUTH_REGISTRATION_ENABLED=true

DEEPSEEK_API_KEY=
DEEPSEEK_API=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

SMTP_DRY_RUN=true
SMTP_FROM=noreply@example.com

METRICS_ENABLED=true
METRICS_AUTH_ENABLED=false
METRICS_BEARER_TOKEN=

CI_WEBHOOK_PUBLIC_BASE_URL=http://localhost:8088/api
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:8088/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:8088/billing/cancel
